{
  "name": "topside",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core --noEmit && npm run check -w apps/web",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
