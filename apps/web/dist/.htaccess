# Topside: settings for Apache shared hosting. Put this next to index.html and git-proxy.php.

# Always use HTTPS: the app sends your Subsurface password to git-proxy.php.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# PHP behind CGI/FastCGI does not see the Authorization header unless it is passed on.
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Web app manifest type, and no long caching for the files that announce updates.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(index.html|help.html|sw.js|manifest.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# git-proxy.php is called as git-proxy.php/<host>/<path>.
AcceptPathInfo On

# git-proxy.config.php holds server settings; it is included by git-proxy.php, never served.
<Files "git-proxy.config.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  # Browsers that were here once use only HTTPS from then on (ignored on plain HTTP).
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' blob: data: https://tile.openstreetmap.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
